DATABASE_URL="postgresql://user:password@host:port/database"
PORT=3001
RESEND_API_KEY="re_your-api-key-here"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"
APP_URL="http://localhost:5173"
UPLOADS_DIR=

# Acceso de administrador (obligatorio para el panel admin)
ADMIN_USER="admin"
ADMIN_PASSWORD="una-contraseña-larga-y-nueva"
# Secreto para firmar los tokens de sesión. Generar con: openssl rand -hex 32
ADMIN_TOKEN_SECRET=""

# Traducción automática del chat en vivo (DeepL). Opcional: sin key, el chat no se traduce.
# Las keys del plan gratuito terminan en ":fx".
DEEPL_API_KEY=""
